          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"status is inactive\", () => pm.expect(pm.response.json().status).to.eql(\"inactive\"));"
            ]
          }
        }
      ],
      "request": {
