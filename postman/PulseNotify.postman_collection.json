      }
    },
    {
      "name": "05 Create alert DEL-BOM (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "pm.test(\"alert is active\", () => pm.expect(j.status).to.eql(\"active\"));",
              "pm.collectionVariables.set(\"alert_id\", j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": 4500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 List my alerts (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"returns a list with my alert\", () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        }
      }
    },
