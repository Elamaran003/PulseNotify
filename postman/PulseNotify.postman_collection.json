              "const j = pm.response.json();",
              "pm.test(\"price in DEL-BOM range\", () => pm.expect(j.price).to.be.within(3000, 7000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/flights/price/?route=DEL-BOM",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "flights",
            "price"
          ],
          "query": [
            {
              "key": "route",
              "value": "DEL-BOM"
            }
          ]
        }
      }
    },
